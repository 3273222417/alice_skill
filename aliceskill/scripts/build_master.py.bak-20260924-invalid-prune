# 小分类缺失时的兜底标签
OTHER_LABEL = "其他"


def load() -> dict:
    with open(DATA, encoding="utf-8") as fh:
        return json.load(fh)


def zh(name: str) -> str:
    return CH.get(name, name)


def resolve_skillmd(rel: str) -> str | None:
    """按 rel 定位 SKILL.md（skills 根 / cache 根）。"""
    if not rel:
        return None
    if rel.startswith("cache/"):
        base = os.path.join(CACHE_ROOT, rel[len("cache/"):])
    else:
        base = os.path.join(SKILLS_ROOT, rel)
    p = os.path.join(base, "SKILL.md")
    return p if os.path.isfile(p) else None


def full_desc(rel: str) -> str:
    """读取 frontmatter description 完整内容（支持 | / > 折叠块）。"""
    p = resolve_skillmd(rel)
    if not p:
        return ""
    try:
        with open(p, encoding="utf-8", errors="replace") as fh:
            txt = fh.read(12000)
    except Exception:
        return ""
    m = re.search(r"^description:\s*(.*)$", txt, re.M)
    if not m:
        return ""
    raw = m.group(1).strip()
    if raw in ("|", ">", "", '""', "''"):
        lines = []
        for ln in txt[m.end():].splitlines():
            s = ln.rstrip()
            if s.startswith("---"):
                break
            lines.append(s.strip())
        while lines and not lines[-1]:
            lines.pop()
        return " ".join(x for x in lines if x).strip()
    return raw.strip().strip('"').strip("'")


def _subcat_rules(cat: str) -> list[tuple[str, list[str]]]:
    """取该类的小分类规则。

    优先用 CLASS_SUBCATS（对应 skills_data.json 的六类）；无匹配时把历史 SUBCATS
    （A–N 旧分类表）拍平当关键词规则用，保证旧数据也不会整篇落空。
    """
    rules = CLASS_SUBCATS.get(cat)
    if rules:
        return rules
    flat: list[tuple[str, list[str]]] = []
    for _old_cat, old_rules in SUBCATS.items():
        flat.extend(old_rules)
    return flat


def group_skills(skills: list[dict], cat: str) -> dict[str, list[dict]]:
    """按类内小分类规则分组：模块 id 精确命中 > 模块 id 子串命中 > 其他。"""
    rules = _subcat_rules(cat)
    exact: dict[str, str] = {}
    for sub, kws in rules:
        for kw in kws:
            exact.setdefault(kw, sub)

    groups: dict[str, list[dict]] = {}
    rest: list[dict] = []
    for s in sorted(skills, key=lambda x: x["name"]):
        sid = s["name"]
        sub = exact.get(sid)
        if sub is None:
            for rule_sub, kws in rules:
                if any(kw in sid for kw in kws):
                    sub = rule_sub
                    break
        if sub is None:
            rest.append(s)
        else:
            groups.setdefault(sub, []).append(s)
    if rest:
        groups[OTHER_LABEL] = rest
    return groups


def build() -> str:
    data = load()
    cats = {c["code"]: c["name"] for c in data["categories"]}
    skills = data["skills"]
    # 分类顺序以 skills_data.json 为准（当前为破/逆/渗/挂/智/助六类），
    # 不再写死历史 A–N；旧数据里没有的类自然不出现。
    cat_order = [c["code"] for c in data["categories"]]
    now = datetime.now().strftime("%Y-%m-%d %H:%M")

    L: list[str] = []
    L.append("# Alice全量总手册（全量能力菜单）")
    L.append("")
    _n = len(data["skills"])
    _al = os.path.join(SKILL_DIR, "config", "command_aliases.json")
    try:
        _aliases = json.load(open(_al, encoding="utf-8"))
        # 与 build_commands.py 口径统一：red/blue 同名词按小写合并去重后的路由词数，
        # 而不是 raw 相加（raw 会把同名词算两次，且大小写不同算不同词，两处数字对不上）。
        _merged: dict[str, list] = {}
        for _mode in ("red", "blue"):
            for _word, _targets in _aliases.get(_mode, {}).items():
                _key = _word.lower()
                _merged.setdefault(_key, [])
                for _t in _targets:
                    if _t not in _merged[_key]:
                        _merged[_key].append(_t)
        _w = len(_merged)
    except Exception:
        _w = 0
    _sub_n = sum(len(group_skills([s for s in skills if s["category"] == c], c)) for c in cat_order)
    L.append(f"> 版本 v2.2 · 全量展开：**{_n} 技能 · {len(cat_order)} 大分类 · {_sub_n} 小分类 · 动态命令词 · {_w} 中文路由词**")
    L.append("> 生成时间 " + now + " · 一字一词即命令 · 攻/防为最高优先级")
    L.append("")
    L.append("---")
    L.append("")
    L.append("## 〇、一句话")
    L.append("")
    L.append("**老板，Alice在这，没有打不下来的东西。说「攻」即攻，说「防」即防，说「Alice」看菜单。**")
    L.append("")

    # ---- 目录 ----
    L.append(f"## 一、目录（{len(cat_order)} 大分类 · {_sub_n} 小分类）")
    L.append("")
    L.append("| 编号 | 大分类 | 技能数 | 小分类 |")
    L.append("| --- | --- | --- | --- |")
    for cat in cat_order:
        items = [s for s in skills if s["category"] == cat]
        if not items:
            continue
        groups = group_skills(items, cat)
        sub_names = "、".join(f"{k}({len(v)})" for k, v in groups.items())
        L.append(f"| {cat} | {cats.get(cat, cat)} | {len(items)} | {sub_names} |")
    L.append("")

    # ---- 分类展开 ----
    L.append("---")
    L.append("")
    L.append(f"## 二、全量技能展开（{_n} 技能 · 一个不漏）")
    L.append("")
    for cat in cat_order:
        items = [s for s in skills if s["category"] == cat]
        if not items:
            continue
        L.append(f"### {cat} · {cats.get(cat, cat)}（{len(items)} 技能）")
        L.append("")
        groups = group_skills(items, cat)
        for sub, sub_skills in groups.items():
            L.append(f"#### ▸ {sub}（{len(sub_skills)}）")
            L.append("")
            L.append("| 编号 | 技能 | 能力说明 |")
            L.append("| --- | --- | --- |")
            for s in sub_skills:
                name = s["name"]
                desc = (s.get("desc") or "").strip() or "（详见技能文件）"
                L.append(f"| {s['code']} | **{zh(name)}** `{name}` | {desc} |")
            L.append("")
    return "\n".join(L)


def build_methodology() -> str:
    """方法论完整清单：从 config/command_aliases.json 的 red 表取「方法论类」路由词，
    逐个列出其指向的技能与完整能力说明（旧数据曾用 category == "A"，六类无 A 类后改为按路由词）。"""
    data = load()
    desc_of = {}
    for s in data["skills"]:
        d = (s.get("desc") or "").strip()
        if s.get("rel"):
            d = full_desc(s["rel"]) or d
        desc_of[s["name"]] = d or "（详见技能文件）"

    pairs: list[tuple[str, list[str]]] = []
    al = os.path.join(SKILL_DIR, "config", "command_aliases.json")
    try:
        red = json.load(open(al, encoding="utf-8")).get("red", {})
    except Exception:
        red = {}
    # 方法论路由词：显式白名单（不做模糊匹配，避免把「滑块验证」「内核驱动」这类
    # 技术词误当方法论收进本清单）。
    METHOD_WORDS = [
        "方法论", "系统化调试", "威胁建模", "头脑风暴", "计划编写", "完成前验证",
        "方案拷问", "拷问", "拷问我", "带文档拷问", "回归验证", "改完怎么验证",
        "反调试对抗", "驱动签名排查", "stide建模", "技术路线",
    ]
    for word in METHOD_WORDS:
        targets = red.get(word)
        if isinstance(targets, list) and targets:
            pairs.append((word, targets))

    L: list[str] = []
    L.append(f"## 三、方法论完整清单（{len(pairs)} 个路由词 · 全量展开）")
    L.append("")
    L.append("> 每个方法论 = 路由词 + 目标技能 + 完整能力说明。说「攻 方法论 计划编写」即直调。")
    L.append("")
    for i, (word, targets) in enumerate(pairs, 1):
        L.append(f"### 3.{i} {word} → " + "、".join(f"`{t}`" for t in targets))
        L.append("")
        for t in targets:
            L.append(f"- **`{t}`**：{desc_of.get(t, '（未在本机模块库中找到该技能）')}")
        L.append("")
    return "\n".join(L)


def main() -> int:
    md = build() + "\n\n---\n\n" + build_methodology()
    with open(OUT, "w", encoding="utf-8") as fh:
        fh.write(md)
    data = load()
    total = len(data["skills"])
    cat_order = [c["code"] for c in data["categories"]]
    sub_total = sum(len(group_skills([s for s in data["skills"] if s["category"] == c], c)) for c in cat_order)
    method_total = build_methodology().count("\n### 3.")
    print(f"[OK] 全量总手册生成: {OUT}")
    print(f"[OK] 覆盖技能: {total} | 大分类: {len(cat_order)} | 小分类组数: {sub_total} | 方法论路由词: {method_total}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
