#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Alice 六类路由菜单生成器（v2 六类细化）
================================
结构：skills/_modules/  全量详细技能（frontmatter 带 x-alice-class）
      skills/aliceskill/     总控（本技能）
      skills/alice-<class>/  六类路由技能

六类（类词 → 路由技能 → 四字名）：
  破 crack   破解卡密   alice-crack    授权/卡密/网络验证/VIP/注册机
  逆 reverse 逆向脱壳   alice-reverse  逆向/脱壳/Hook/取证/协议还原
  渗 pentest 网络渗透   alice-pentest  Web 挖洞/SQL 注入/端口/资产/后渗透
  挂 game    游戏辅助   alice-game     内存/ESP/注入/反作弊对抗
  智 ai      AI 破限    alice-ai       越狱/提示注入/MCP/RAG 攻击
  助 assist  技能助理   alice-assist   元技能/业务/平台/质量查询/吸收新技能

职责：
  ① 扫描 _modules/（+ .system/ + plugins/cache）→ 六类归类
  ② 生成 aliceskill/SKILL.md 总菜单（六类索引 + 中文描述 + 激活词速查）
  ③ 生成 6 个路由技能 SKILL.md（中文模块索引，图1样式：触发/别用）
  ④ 重写 _modules/alice_manifest.json
  ⑤ 写 scripts/skills_data.json（category = 六类 code）
  ⑥ --audit 未标记清单

用法:
  python rebuild_menu.py               # 全量重建
  python rebuild_menu.py --audit       # 自检：未标记技能
  python rebuild_menu.py --check       # 只统计不写
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime

try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass


def _resolve_codex_home() -> str:
    env = os.environ.get("CODEX_HOME")
    if env:
        return env
    here = os.path.dirname(os.path.abspath(__file__))
    walk = os.path.dirname(os.path.dirname(os.path.dirname(here)))
    if os.path.isdir(os.path.join(walk, "skills")):
        return walk
    return os.path.expanduser("~/.codex")


SELF_NAME = "aliceskill"
CODEX_HOME = _resolve_codex_home()
SKILLS_ROOT = os.path.join(CODEX_HOME, "skills")
MODULES_ROOT = os.path.join(SKILLS_ROOT, "_modules")
CACHE_ROOT = os.path.join(CODEX_HOME, "plugins", "cache")
THIS_DIR = os.path.dirname(os.path.abspath(__file__))
SKILL_DIR = os.path.dirname(THIS_DIR)
JSON_OUT = os.environ.get("ALICE_DATA") or os.path.join(SKILLS_ROOT, SELF_NAME, "scripts", "skills_data.json")
SKILLMD_OUT = os.path.join(SKILLS_ROOT, SELF_NAME, "SKILL.md")
MANIFEST = os.path.join(MODULES_ROOT, "alice_manifest.json")
ZH_DESC = os.path.join(MODULES_ROOT, "zh_desc.json")
RATINGS = os.path.join(MODULES_ROOT, "skill_ratings.json")
AUTH_FILE = os.path.join(SKILL_DIR, "config", "authorization.json")
SKIP_DIRS = {".git", "node_modules", "__pycache__", "assets", "references", "subskills"}

CLASSES = ("crack", "reverse", "pentest", "game", "ai", "assist")
CLASS_CN = {
    "crack": "破解卡密",
    "reverse": "逆向脱壳",
    "pentest": "网络渗透",
    "game": "游戏辅助",
    "ai": "AI 破限",
    "assist": "技能助理",
}
CLASS_SUB = {
    "crack": "授权 / 卡密 / 网络验证 / VIP / 注册机 / 本地文件破解",
    "reverse": "逆向 / 脱壳 / Hook / 取证 / 协议还原 / 样本与流量分析（「防」模式取证链）",
    "pentest": "Web 挖洞 / SQL 注入 / 端口与资产 / 钓鱼与免杀 / 后渗透 / 无线",
    "game": "游戏内存 / ESP / 注入 / 反作弊对抗 / 模拟器",
    "ai": "LLM 越狱 / 提示注入 / MCP 与 RAG 攻击 / 数据外带",
    "assist": "元技能 / 业务自动化 / 平台 / 技能质量评分 / 吸收新技能 / 新机迁移",
}
ROUTER = {c: f"alice-{c}" for c in CLASSES}
DEFAULT_CLASS = "assist"
# 无 SKILL.md 的脚本包：特判类
NO_SKILLMD_CLASS = {"web-exploitation": "pentest"}


def load_auth() -> dict:
    try:
        with open(AUTH_FILE, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return {}


def load_zh() -> dict:
    try:
        with open(ZH_DESC, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return {}


def _read_desc(skillmd: str) -> str:
    try:
        with open(skillmd, encoding="utf-8", errors="replace") as fh:
            txt = fh.read(3000)
        m = re.search(r"^description:\s*(.*)$", txt, re.M)
        if not m:
            return ""
        raw = m.group(1).strip()
        if raw in ("|", ">", "", '""'):
            for ln in txt[m.end():].splitlines():
                s = ln.strip().strip('"').strip("'")
                if s and not s.startswith(("---", "#", "name:")):
                    return s[:100]
            return ""
        return raw.strip().strip('"').strip("'")[:100]
    except Exception:
        return ""


def _read_class(skillmd: str) -> str | None:
    try:
        with open(skillmd, encoding="utf-8", errors="replace") as fh:
            txt = fh.read(3000)
        m = re.search(r"^x-alice-class:\s*([a-z]+)\s*$", txt, re.M)
        if m and m.group(1) in CLASSES:
            return m.group(1)
        return None
    except Exception:
        return None


def _rel_to_skills(abs_path: str) -> str | None:
    try:
        rel = os.path.relpath(abs_path, SKILLS_ROOT)
        if not rel.startswith(".."):
            return rel.replace("\\", "/")
    except ValueError:
        pass
    try:
        rel = os.path.relpath(abs_path, CACHE_ROOT)
        if not rel.startswith(".."):
            return "cache/" + rel.replace("\\", "/")
    except ValueError:
        pass
    return None


def scan() -> tuple[list[dict], list[str]]:
    skills: dict[str, dict] = {}
    unmarked: list[str] = []
    roots = [r for r in (MODULES_ROOT, os.path.join(SKILLS_ROOT, ".system"), CACHE_ROOT)
             if os.path.isdir(r)]
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and ".bak" not in d.lower()]
            if not any(f.lower() == "skill.md" for f in filenames):
                continue
            name = os.path.basename(dirpath)
            if ".bak" in name.lower() or name.lower().startswith("bak"):
                continue
            if name in ("skills", "docs", "scripts") and os.path.basename(os.path.dirname(dirpath)):
                name = os.path.basename(os.path.dirname(dirpath))
            if name in (SELF_NAME,) or not name or (
                    name.startswith("alice-") and name not in ("alice-migrate", "alice-absorb", "alice-activation", "alice-progressive", "alice-toolchain", "alice-inject")):
                continue
            rel = _rel_to_skills(dirpath)
            if not rel:
                continue
            skillmd = next(
                (os.path.join(dirpath, f) for f in filenames if f.lower() == "skill.md"),
                os.path.join(dirpath, "SKILL.md"))
            desc = _read_desc(skillmd)
            cls = _read_class(skillmd)
            if cls is None:
                unmarked.append(name)
                cls = NO_SKILLMD_CLASS.get(name, DEFAULT_CLASS)
            entry = {
                "name": name, "rel": rel, "abs": dirpath, "desc": desc,
                "class": cls,
                "builtin": rel.startswith("cache") or rel.startswith(".system"),
            }
            if name in skills:
                old = skills[name]
                old_cache = old["rel"].startswith("cache")
                new_cache = rel.startswith("cache")
                keep_old = (
                    (old_cache and not new_cache)
                    or (old_cache == new_cache and old["desc"] and not desc)
                    or (old_cache == new_cache and old["desc"] == desc and len(old["rel"]) <= len(rel))
                )
                if keep_old:
                    continue
            skills[name] = entry
    return list(skills.values()), unmarked


# ---------------------------------------------------------------- 生成
# 每类"代表模块"（主菜单弹药库展示用；说明这类主要是能做什么）
REPRESENTATIVE = {
    "crack": ["crack-keygen", "keygen-build", "network-bypass", "vip-bypass"],
    "reverse": ["anti-debug", "binary-protect-bypass", "dn-decompile", "aob-scan"],
    "pentest": ["sqli-test", "web-recon", "exploit-attack", "threat-modeling"],
    "game": ["dma-cardkey-evo-crack", "exact-scan", "pointer-chain", "code-inject"],
    "ai": ["llm-jailbreaking-techniques", "llm-offense-kit"],
    "assist": ["skills-toolkit", "hatch-pet", "session-batch-creator", "alice-migrate", "alice-absorb", "alice-inject"],
}
CLASS_ABILITY = {
    "crack": "算卡密/写注册机/去网络验证/解 VIP",
    "reverse": "脱壳反编译/抓样本/还原协议/取证溯源",
    "pentest": "Web 挖洞注入/摸资产/拿权限/打无线",
    "game": "读写内存/ESP 注入/对抗反作弊",
    "ai": "越狱破限/提示注入/打 MCP 与 RAG",
    "assist": "管技能/做业务自动化/吸收新技能",
}


def render_section3(skills: list[dict], zh: dict) -> list[str]:
    """§3 六类弹药库：只给代表模块与能力一句话，全量清单在各路由技能页。"""
    counts = {c: 0 for c in CLASSES}
    for s in skills:
        counts[s["class"]] += 1
    out = ["", "### 六类弹药库（共 %d）" % len(skills), ""]
    out.append("| 类词 | 四字名 | 数量 | 路由技能 | 主要是能做什么 | 代表模块 |")
    out.append("|:--:|:--|---:|:--|:--|:--|")
    have = {s["name"] for s in skills}
    for c in CLASSES:
        reps = [r for r in REPRESENTATIVE[c] if r in have]
        reps_s = " ".join(f"`{r}`" for r in reps) if reps else "（见路由页）"
        out.append(f"| **{WORD_OF[c]}** | {CLASS_CN[c]} | {counts[c]} | `{ROUTER[c]}` | {CLASS_ABILITY[c]} | {reps_s} |")
    out.append("")
    out.append("> 全量模块清单**不在这里**：说类词或直接打开路由技能 SKILL.md，在它的模块索引里选模块取正文，开场省 token。")
    out.append("")
    return out



WORD_OF = {"crack": "破", "reverse": "逆", "pentest": "渗", "game": "挂", "ai": "智", "assist": "助"}


def render_router_skill(cls: str, group: list[dict], zh: dict, ratings: dict) -> str:
    """六类路由技能 SKILL.md：中文模块索引 + 触发/别用（图1样式）。"""
    terms = {
        "crack": "卡密/激活码/注册机/license/机器码/网络验证/hosts 劫持/证书/试用/时间限制/VIP/会员/付费/去验证",
        "reverse": "逆向/脱壳/反编译/Frida/IDA/Ghidra/PE/ELF/APK/Hook/协议还原/取证/样本/流量分析/内核/混淆还原",
        "pentest": "渗透/挖洞/SQL注入/越权/SSRF/XSS/端口扫描/资产/子域/钓鱼/免杀/勒索/无线/提权/后渗透",
        "game": "游戏内存/ESP/自瞄/透视/注入/偏移/反作弊/模拟器/外挂/加速/修改器/CE/指针/视矩阵/坐标",
        "ai": "越狱/破限/提示注入/prompt injection/LLM 攻击/agent 滥用/MCP 攻击/RAG 投毒/系统提示词泄露",
        "assist": "写技能/装技能/打包技能/技能质量/剔除低质量/吸收新技能/自动化/业务/平台/元技能",
    }[cls]
    colo = WORD_OF[cls]
    lines = [
        "---",
        f"name: {ROUTER[cls]}",
        f"description: \"{CLASS_CN[cls]}路由技能（{CLASS_SUB[cls]}）。用户说白话也命中，术语触发词：{terms}。触发后在本页模块索引中选定模块，取正文再执行；每次最多取 4 个模组（优先取项目相关高评分模块）。\"",
        "---",
        "",
        f"# {colo} · {CLASS_CN[cn_fix(cls)]}（{ROUTER[cls]}）",
        "",
        f"{CLASS_SUB[cls]}。覆盖 `_modules/` 内 {len(group)} 个模块；本页只做路由，正文全部在模块库。",
        "",
        "## 模块索引（命中哪条取哪条；一条任务最多取 4 个模块，优先项目相关高评分模块）",
        "",
        "**选择规则**",
        "",
        "0. 先用一句话概括用户要达成的结果，再据此找对应模块；不要只按字面关键词匹配。",
        "1. 用户原话命中下面哪条，就取那条的正文；多条命中时**优先取评分高（x/10）且与项目最相关的**；无评分标记时按第一条命中执行，不因缺评分停手。",
        "2. **碰壁（模块正文对不上、思路失败、卡住）→ 回总控 `../aliceskill/SKILL.md` 重新选类，或回本页换支线模块**，不要硬磕。",
        "3. 拿不准属于哪类、或丢失上下文时，先读 `../aliceskill/SKILL.md` 总菜单（§3 弹药库 + 两级路由规则）再回来选模块。",
    ]
    for s in group:
        d = zh.get(s["name"]) or (s.get("desc") or "").replace("\n", " ").strip()
        flag = " ⚡宿主内置（正文随宿主客户端技能空间提供，本包仅索引）" if s.get("builtin") else ""
        score = ratings.get(s["name"])
        score_s = f" 【{score}/10】" if isinstance(score, (int, float)) else ""
        lines.append(f"- `{s['name']}`{score_s} — {d}{flag}")
    lines += [
        "",
        "## 取模块正文（命中后必须执行，不许跳过）",
        "",
        "优先用相对路径直接读：",
        "",
        "```text",
        f"读 ../_modules/<MODULE_ID>/SKILL.md   （相对本技能目录）",
        "```",
        "",
        "绝对路径兜底（PowerShell）：",
        "",
        "```powershell",
        f'Get-Content -LiteralPath "{MODULES_ROOT}/<MODULE_ID>/SKILL.md" -Raw -Encoding UTF8',
        "```",
        "",
        "> 上行绝对路径由 `rebuild_menu.py` 生成时写入本机技能根；换机/换客户端后若与本机不符，重跑 `rebuild_menu.py` 自动刷新（迁移手册：`../_modules/alice-migrate/SKILL.md`）。相对路径优先，通常无需兜底。",
        "**硬性要求**",
        "",
        "1. 取到的正文**必须整篇读完再动手**：不许只读开头就执行，不许跳读，不许凭记忆替代正文。",
        "2. 没取到正文不许声称「已按该方法执行」；取用失败要报告真实错误并重试一次。",
        "3. 模块正文与本页冲突时，以模块正文为准。",
        "4. 换新任务才重取；同一任务里已经取过的模块不用重复取。",
        "5. **每次最多取 4 个模组（优先项目相关高评分模块）**；多阶段任务完成一个阶段再取下一批。",
        "",
        "## 技能质量评分（用户说「检测技能质量/给技能打分/评分」时触发）",
        "",
        "**先修复，后评分**——评分前逐个模块做快速体检，发现问题先修再评，避免带病评分：",
        "",
        "1. 包问题检查：`_modules/<id>/SKILL.md` 是否存在/可读；frontmatter 是否完整（`name:`/`description:`）；",
        "   正文是否为空壳（过短/与 description 同文）；scripts/references 引用的文件是否缺失；编码是否正常（无乱码/BOM 错位）。",
        "2. 路由问题检查：frontmatter `x-alice-class` 缺失或与路由页归类不符 → 补标记或用 `absorb_skill.py --class` 重吸收；",
        "   模块 id 与目录名不一致、模块索引描述与实际正文明显不符 → 以正文为准修正 `_modules/zh_desc.json` 后重跑 `rebuild_menu.py`。",
        "3. 修复方式：小问题（标记/描述/编码）直接修文件 + 重跑 `rebuild_menu.py`；包实质损坏且无修复价值 → 向用户报告建议剔除，",
        "   未修复的问题逐条列出。**修复动作必须向用户汇报（改了什么/为什么）**。",
        "",
        "体检通过后 AI 主观打分，不限语言，脚本不做检测。对用户指定（或本页全部）模块逐个：完整读 SKILL.md 正文 → 按",
        "实用性/完整性/可执行性/描述准确度综合评 1-10 分（整数；空壳 1-3，可用 5-6，优质 8-10）→",
        "**实时把评分写进本页模块索引对应条目的 【x/10】 标记**（改本文件并落盘），向用户逐条报「`<id>` x/10 理由一句话」。",
        "评分落盘：把全部评分写入 `_modules/skill_ratings.json`（JSON 对象 `{\"<模块id>\": <分数>}`），",
        "然后重跑 `rebuild_menu.py` 使评分渲染固化；无评分条目不显示标记。",
        "评分库为空属正常初始态：用户首次要求评分时按本节流程现场评；日常取模块不依赖评分，缺评分照常执行。",
        "",
    ]
    if cls == "assist":
        lines += [
            "## 吸收新技能（用户给出新技能地址时）",
            "",
            "```bash",
            "python ../aliceskill/scripts/absorb_skill.py <新技能目录或zip> --class crack|reverse|pentest|game|ai|assist --desc \"中文描述\"",
            "```",
            "",
            "流程：AI 先完整读新技能 SKILL.md → 判六类（破/逆/渗/挂/智/助）→ 拟 ≤40 字中文描述（越短越好但必须清楚）→ 跑 `absorb_skill.py` 落库 → 重跑 `rebuild_menu.py` → 三自检 → 回本页确认新条目。全程向用户汇报「当前进度：N%」。判类拿不准 → 读 `../_modules/alice-absorb/SKILL.md` 手册照做。",
            "",
            "## 注入总路由到当前客户端（用户说「注入提示词/注入路由」时）",
            "",
            "```bash",
            "python ../aliceskill/scripts/inject_route_prompt.py --check   # 检测并显示当前客户端（先给用户看）",
            "python ../aliceskill/scripts/inject_route_prompt.py           # 确认后注入（仅当前客户端，备份+幂等）",
            "```",
            "",
            "铁律：**只注入用户当前正在用的客户端**（codex/dsh/pi/workbuddy/omp/claude/zcode/cursor），绝不批量注入；检测结果与目标文件必须显示给用户；检测不确定 → 问用户，禁止猜测（exit 3 即此情况）。手册：`../_modules/alice-inject/SKILL.md`。",
        ]
    return "\n".join(lines)


def render_common_cmds() -> list[str]:
    """§4 Alice 技能常用指令：只列真实存在的入口（路径经本机校验后写死为相对/绝对混合）。"""
    sr = SKILLS_ROOT.replace("\\", "/")
    return [
        "## 4. Alice 技能常用指令（说出指令词即执行，无需加类词）",
        "",
        "| 指令（直接说） | 作用 | 真实入口 |",
        "|:--|:--|:--|",
        "| `alice迁移自检` / `迁移自检` / `技能包迁移` / `换电脑` / `新机器` / `路径修复` | 定位本机 skills 根 → 刷生成物内嵌路径 → 对齐路由指引 → 四点自检（不拷贝文件） | 模块 `alice-migrate` |",
        "| `吸收新技能` / `吸收技能` / `装技能` | AI 读完新技能正文 → 判六类 → 拟中文描述 → 落库 → 重建菜单 | 模块 `alice-absorb` + `scripts/absorb_skill.py` |",
        "| `技能评分` / `技能打分` / `技能质量` / `检测技能质量` | 逐模块体检 → 综合评 1-10 → 实时写路由页 【x/10】 → 落盘 skill_ratings.json | `alice-assist` 路由页 §技能质量评分 |",
        "| `GitHub技能` / `从GitHub装技能` / `技能下载` / `技能安装` | 从 GitHub 选源下载技能 → 再走吸收流程落库 | 模块 `eni-github-workflow-hub` + `skill-installer` |",
        "| `技能打包` / `打包技能` / `安装技能包` / `导出技能` / `收集技能` | 打包本机技能为 zip，或从 zip 一键安装（自动备份） | 模块 `skills-toolkit` ⚠️脚本本机缺失，见下注 |",
        "| `注入总路由` / `注入提示词` / `注入路由` / `连接总路由` | 检测当前客户端 → 只把总路由块注入该客户端（幂等+备份） | 模块 `alice-inject` + `scripts/inject_route_prompt.py` |",
        "| `任务路由` / `全链路` | 七路任务路由一体化（状态锁存/验证/回滚，17 域 181 节点） | 模块 `alice-toolchain` |",
        "| `堡垒` / `开堡垒` / `开战保护` / `保护攻与防` / `主动保护` | 五层保护全开：护盾 → 看门狗 → 熔断 → 反击 → 自检 | `scripts/alice_fortress.py up --mode red --goal \"<目标>\"` |",
        "| `堡垒状态` / `保护状态` | 堡垒五层保护状态总览 | `scripts/alice_fortress.py status` |",
        "| `保护演练` / `保护启动` | 受阻反击演练：判定阻碍类型 → 生成反击载荷 | `scripts/alice_fortress.py drill --attack \"<阻碍>\"` |",
        "| `看门狗` / `开看门狗` | 目标锁存 + 偏离矫正（bias 越限自动拉回目标） | `scripts/alice_watchdog.py start --mode red --goal \"<目标>\"` |",
        "| `护盾` / `开护盾` / `护盾巡查` | 关键文件 SHA-256 指纹巡查，发现篡改自动恢复 | `scripts/alice_shield.py check --restore` |",
        "| `破甲内核` / `破甲模式` / `目标账本` / `跨轮续作` / `拒答修复` | 目标账本（objective/constraints/deliverable/done_when）+ 跨轮续作 + 拒答修复 | `scripts/alice_armor.py ledger --goal \"<目标>\" --deliverable \"<交付物>\" --done \"<完成判据>\"` |",
        "| `熔断器` / `输出风暴` | 输出风暴/超时/熔断词 → 物理终止失控进程 | `scripts/alice_breaker.py --storm-limit 4000` |",
        "| `受阻反击` / `反击` / `反制` / `不惯着` / `干它` / `反弹` / `反击侦察` | 阻碍判定 + 反击战术选择 + 载荷生成 | `scripts/counter_attack.py scan --log \"<阻碍>\"` |",
        "| `实弹投递` / `物理投递` / `污染落盘` / `网络探测` | 反击载荷投递 / 落盘 / TCP 连通探测 | `scripts/counter_attack.py deliver/plant/probe …` |",
        "| `常用指令` / `技能指令` / `alice指令` / `技能菜单` / `激活词速查` | 重看本节与激活词速查表 | 本页（总控） |",
        "",
